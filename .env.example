# Copy to .env and fill in values:  cp .env.example .env

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-api03-...

# Required: Public HTTPS URL of the TripletexMcpServer
# Anthropic's API servers connect to this URL to call Tripletex tools.
# Must be reachable from the internet (use Nginx reverse proxy on your Azure VM).
# Example:  https://your-vm.example.com/mcp
MCP_SERVER_URL=https://your-vm.example.com/mcp
